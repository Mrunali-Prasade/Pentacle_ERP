# =============================================================
# Pentacle Payroll - Environment Configuration
# Copy this file to .env and fill in the values.
# NEVER commit your actual .env file to version control.
# =============================================================

# --- Database ---
# Postgres connection string (required in production)
POSTGRES_URL="postgres://user:password@host:5432/dbname?sslmode=require"

# --- Authentication ---
# A long, random secret string used to sign JWT tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# REQUIRED IN PRODUCTION. The server will refuse to start without this.
JWT_SECRET="replace-with-a-long-random-secret-at-least-64-characters"

# --- Application ---
# The public URL of your deployed app (e.g. https://payroll.yourcompany.com)
# Used to lock CORS to your domain.
APP_URL="https://payroll.yourcompany.com"

# --- Encryption at rest (required in production) ---
# 64 hex chars (32 bytes). Encrypts Aadhaar / PAN / bank numbers in the database.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# KEEP THIS SECRET AND BACKED UP — losing it makes existing encrypted values unrecoverable.
ENCRYPTION_KEY="replace-with-64-hex-characters"

# --- Optional / recommended (see DEPLOYMENT_CHECKLIST.md) ---
# CSP_ENFORCE=1                 # turn the Content-Security-Policy from report-only to blocking
# PG_CA_CERT="-----BEGIN CERTIFICATE----- ..."   # verify the DB server's TLS certificate
# CRON_SECRET="a-long-random-string"             # protects the daily reminder endpoint
# RESEND_API_KEY="..."          # send notification emails
# NOTIFY_FROM_EMAIL="payroll@yourcompany.com"
# AZURE_TENANT_ID / AZURE_CLIENT_ID / AZURE_CLIENT_SECRET / ONEDRIVE_DRIVE  # durable file storage
